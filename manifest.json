{
  "manifest_version": 3,
  "name": "Prairie Dark Mode",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "Dark mode for PrairieLearn and PrairieTest.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.prairielearn.com/*",
        "https://*.prairielearn.org/*",
        "https://*.prairietest.com/*",
        "https://*.prairietest.org/*"
      ],
      "css": ["darkmode.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
